# Variables of the MS08 deployment.
#
# In the normal flow this file is NOT used: the self-hosted runner receives them from the GitHub Environment
# `ms08-test` or `ms08-prod`. It is for a manual deploy on the VM or to document what the stack needs.

# Environment: test (edge port 8443) or prod (port 443)
ENTORNO=test

# Image published by the CI (the -api suffix is added by ci.yml)
IMAGE=ghcr.io/campusseguro-dosw-2026-2/ms08-analytics-and-audit-api
TAG=sha-REEMPLAZAR

# Where deploy.sh leaves the stack files
DEPLOY_DIR=/home/azureuser/campusseguro/ms08

# Connection string of the Azure DocumentDB cluster, copied from the portal (Connection strings).
# SECRET: only in the GitHub Environment secret MONGODB_URI, never in the repository or in chat.
# The free tier gives ONE cluster per subscription, so test and prod share it with different databases:
#   test -> .../campusseguro_audit_test?...      prod -> .../campusseguro_audit?...
MONGODB_URI=REEMPLAZAR

# Optional
LOG_LEVEL=INFO
AUDIT_TTL_INDEX_ENABLED=true
AUDIT_CLEANUP_JOB_ENABLED=false
